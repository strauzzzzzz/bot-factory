{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "python webapp.py",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "variables": [
      {
        "name": "DATA_DIR",
        "value": "/app/data"
      }
    ],
    "volumeMounts": [
      {
        "name": "botfactory-data",
        "mountPath": "/app/data"
      }
    ]
  }
}